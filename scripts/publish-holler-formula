#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo "usage: $0 VERSION" >&2
  exit 2
fi

version=${1#v}
case "$version" in
  ""|*[!0-9A-Za-z.-]*)
    echo "invalid version: $1" >&2
    exit 2
    ;;
esac

script_dir=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd)
repository_dir=$(dirname -- "$script_dir")
template="$repository_dir/Formula/holler.rb.tmpl"
formula="$repository_dir/Formula/holler.rb"
archive=$(mktemp "${TMPDIR:-/tmp}/holler-source.XXXXXX")
rendered=$(mktemp "${TMPDIR:-/tmp}/holler-formula.XXXXXX")
trap 'rm -f "$archive" "$rendered"' EXIT HUP INT TERM

url="https://github.com/72olabs/holler/archive/refs/tags/v${version}.tar.gz"
if ! curl --fail --location --silent --show-error "$url" --output "$archive"; then
  if ! command -v gh >/dev/null 2>&1; then
    echo "public archive unavailable and gh is not installed for authenticated fallback" >&2
    exit 1
  fi
  token=$(gh auth token)
  printf 'header = "Authorization: Bearer %s"\n' "$token" |
    curl --config - --fail --location --silent --show-error "$url" --output "$archive"
fi
checksum=$(shasum -a 256 "$archive" | awk '{print $1}')

refs=$(GIT_TERMINAL_PROMPT=0 git ls-remote https://github.com/72olabs/holler.git \
  "refs/tags/v${version}" "refs/tags/v${version}^{}" 2>/dev/null || true)
commit=$(printf '%s\n' "$refs" | awk '$2 ~ /\^\{\}$/ {print $1; exit}')
if [ -z "$commit" ]; then
  commit=$(printf '%s\n' "$refs" | awk 'NR == 1 {print $1}')
fi
case "$commit" in
  ""|*[!0-9a-f]*)
    echo "could not resolve commit for tag v${version}" >&2
    exit 1
    ;;
esac
if [ "${#commit}" -ne 40 ]; then
  echo "resolved commit for tag v${version} is not a full SHA" >&2
  exit 1
fi

sed \
  -e "s/@VERSION@/$version/g" \
  -e "s/@SHA256@/$checksum/g" \
  -e "s/@COMMIT@/$commit/g" \
  "$template" > "$rendered"

ruby -c "$rendered" >/dev/null
chmod 0644 "$rendered"
mv "$rendered" "$formula"

echo "rendered $formula"
echo "version: $version"
echo "source:  $url"
echo "sha256:  $checksum"
echo "commit:  $commit"
