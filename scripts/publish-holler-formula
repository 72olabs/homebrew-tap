#!/bin/bash
set -euo pipefail

if [[ $# != 2 ]]; then
  echo "usage: $0 VERSION proprietary" >&2
  exit 2
fi
version=${1#v}
if [[ ! $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "expected a stable three-part version" >&2
  exit 2
fi
case "$2" in
  proprietary) license=':cannot_represent' ;;
  *) echo "select the reviewed license shipped with this release" >&2; exit 2 ;;
esac

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repository_dir=$(dirname -- "$script_dir")
temporary=$(mktemp -d "${TMPDIR:-/tmp}/holler-formula.XXXXXX")
trap 'rm -rf -- "$temporary"' EXIT HUP INT TERM
base="https://github.com/72olabs/holler-releases/releases/download/v${version}"

checksums=()
for platform in darwin-arm64 darwin-amd64 linux-amd64; do
  name="holler-${version}-${platform}.tar.gz"
  # -q disables ~/.curlrc: public downloads must not rely on local credentials.
  curl -q --fail --location --silent --show-error --proto '=https' --proto-redir '=https' \
    "$base/$name" --output "$temporary/$name"
  curl -q --fail --location --silent --show-error --proto '=https' --proto-redir '=https' \
    "$base/$name.sha256" --output "$temporary/$name.sha256"
  actual=$(shasum -a 256 "$temporary/$name" | awk '{print $1}')
  expected=$(awk 'NR == 1 {print $1}' "$temporary/$name.sha256")
  filename=$(awk 'NR == 1 {print $2}' "$temporary/$name.sha256")
  if [[ ! $expected =~ ^[0-9a-f]{64}$ || $actual != "$expected" || $filename != "$name" ]]; then
    echo "checksum mismatch or malformed sidecar: $name" >&2
    exit 1
  fi
  checksums+=("$actual")
done

sed \
  -e "s/@VERSION@/$version/g" \
  -e "s/@LICENSE@/$license/g" \
  -e "s/@DARWIN_ARM64_SHA256@/${checksums[0]}/g" \
  -e "s/@DARWIN_AMD64_SHA256@/${checksums[1]}/g" \
  -e "s/@LINUX_AMD64_SHA256@/${checksums[2]}/g" \
  "$repository_dir/Formula/holler.rb.tmpl" > "$temporary/holler.rb"
ruby -c "$temporary/holler.rb" >/dev/null
install -m 0644 "$temporary/holler.rb" "$repository_dir/Formula/holler.rb"
echo "Rendered binary-only Holler $version formula from verified public assets."
